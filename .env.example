# Copy to .env for local dev. Never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
JWT_SECRET=change-me-long-random-string

# Public URL of the site (used for the Google OAuth redirect URI: $APP_URL/api/oauth/callback)
APP_URL=http://localhost:3000

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=manhey@gmail.com

# Google Drive (public root folder)
GOOGLE_DRIVE_FOLDER_ID=

# OpenRouter (translation, address inference, image effects)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Google Maps: server key (Geocoding + Places) and browser key (Maps JavaScript, referrer-restricted)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Scheduler: in-process daily sync at 03:00 UTC; the HTTP endpoint needs CRON_SECRET
CRON_SECRET=
# DAILY_SYNC_ENABLED=true

# Optional S3-compatible storage (only for the legacy photo upload module)
# S3_ENDPOINT= S3_REGION= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_PUBLIC_URL=
